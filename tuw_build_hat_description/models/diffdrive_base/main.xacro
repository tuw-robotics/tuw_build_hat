<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="init_controller" default="true" />
    <xacro:property name="init_controller" value="$(arg init_controller)"/>
    <xacro:arg name="simulated" default="true" />
    <xacro:property name="simulated" value="$(arg simulated)"/>

    <xacro:include filename="body/common_properties.xacro" />
    <xacro:include filename="body/mobile_base.xacro" />
    <xacro:if value="${init_controller}">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:if>

</robot>