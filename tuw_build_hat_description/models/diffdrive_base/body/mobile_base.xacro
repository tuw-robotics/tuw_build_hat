<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="plate_length" value="0.152" />
    <xacro:property name="plate_width" value="0.088" />
    <xacro:property name="plate_height" value="0.008" />
    <xacro:property name="plate_offset_z" value="0.016" />
    <xacro:property name="plate_offset_x" value="0.032" />
    <xacro:property name="caster_wheel_offset" value="0.088" />
    <xacro:property name="wheel_radius" value="0.028" />
    <xacro:property name="wheel_length" value="0.014" />

    <link name="base_link" />
    <link name="center_link"/>

    <link name="plate_link">
        <visual>
            <geometry>
                <mesh filename="package://tuw_build_hat_description/models/lego/meshes/plate_11x19x1.obj" scale="1 1 1" />
            </geometry>
            <origin xyz="0 0 ${plate_height / 2.0}" rpy="0 0 ${pi / 2.0}" />
            <material name="yellow" />
        </visual>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <mesh filename="package://tuw_build_hat_description/models/lego/meshes/wheel.obj" scale="1 1 1" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="sky_blue" />
            </visual>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
    </link>

    <joint name="center_joint" type="fixed">
        <parent link="base_link" />
        <child link="center_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="center_plate_joint" type="fixed">
        <parent link="center_link" />
        <child link="plate_link" />
        <origin xyz="${plate_offset_x} 0 ${plate_offset_z}" rpy="0 0 0"/>
    </joint>

    <joint name="center_right_wheel_joint" type="continuous">
        <parent link="center_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 ${-(plate_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="center_left_wheel_joint" type="continuous">
        <parent link="center_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 ${(plate_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="center_caster_wheel_joint" type="fixed">
        <parent link="center_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${caster_wheel_offset} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

</robot>