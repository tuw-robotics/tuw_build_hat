<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    

    <ros2_control name="MobileBase" type="system">
        <hardware>
            <plugin>tuw_build_hat_hardware_interface/BuildHatHardwareInterface</plugin>
            <param name="serial_port">/dev/ttyAMA0</param>
            <param name="port_motor_left">0</param>
            <param name="port_motor_right">1</param>
            <param name="msgs_loglevel">0</param>
            <param name="filename_serial_log"></param>
            <param name="filename_msgs_log">/tmp/build_hat_msg.log</param>
            <param name="kp">0.003</param>
            <param name="ki">0.001</param>
            <param name="kd">0.0</param>
        </hardware>
        <joint name="center_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>        
        <joint name="center_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>        
    </ros2_control>

</robot>