<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <ros2_control name="MobileBase" type="system">    
        <hardware>
            <xacro:if value="${simulated}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:if value="${not simulated}">
                <plugin>tuw_build_hat_hardware_interface/BuildHatHardwareInterface</plugin>
                <param name="serial_port">/dev/ttyAMA0</param>
                <param name="port_motor_left">0</param>
                <param name="port_motor_right">1</param>
                <param name="msgs_loglevel">0</param>
                <param name="filename_serial_log"></param>
                <param name="filename_msgs_log">/tmp/build_hat_msg.log</param>
                <param name="kp">0.003</param>
                <param name="ki">0.001</param>
                <param name="kd">0.0</param>
            </xacro:if>
        </hardware>
        <joint name="right_motor_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="left_motor_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

    <xacro:if value="${simulated}">
        <!-- Load the gz_ros2_control plugin to instantiate a controller manager with its interfaces bridged to gazebo -->
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
              <!-- ROS parameters for the controller manager given via a path to the param .yaml or directly as xml tags -->
              <parameters>/home/arc/projects/imr2026_solution/ws02/src/tuw_build_hat/tuw_build_hat_bringup/config/diffdrive_controllers.yaml</parameters>
              <!--
              <hold_joints>true</hold_joints>
              <position_proportional_gain>0.1</position_proportional_gain>-->
              <!-- remappings of the instantiated controller manager done in <ros> tag
              <ros>
                <namespace>my_namespace</namespace>
                <remapping>/robot_description:=/robot_description_full</remapping>
              </ros>
              -->
            </plugin>
        </gazebo>
    </xacro:if>

</robot>